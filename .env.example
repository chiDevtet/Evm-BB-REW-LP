RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
ENGINE_ADDRESS=
TOKEN_ADDRESS=
TOKEN_DEPLOY_BLOCK=
ENGINE_DEPLOY_BLOCK=
# Supply the deployed Forge hook and verified compatible Universal Router.
HOOK_ADDRESS=
V4_ROUTER_ADDRESS=
V4_QUOTER_ADDRESS=
V4_SIX_FIELD=true
V2_ROUTER_ADDRESS=0x89e5db8b5aa49aa85ac63f691524311aeb649eba
V2_FACTORY_ADDRESS=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
OWNER_ADDRESS=
KEEPER_ADDRESS=
TREASURY_ADDRESS=
# Server-only; separate limited keeper from owner/multisig.
KEEPER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
DRY_RUN=true
CONFIRMATIONS=20
POLL_SECONDS=60
CADENCE_SECONDS=600
MAX_PROCESS_ETH=0.01
MIN_PROCESS_ETH=0.001
SLIPPAGE_BPS=100
MAX_PRICE_DEVIATION_BPS=300
LOG_CHUNK=500
MIN_HOLDING_RAW=1
# Exclude all AMM custody, bridges, distributors, dead addresses; token balances only.
EXCLUDED_ADDRESSES=
DATA_DIR=./data
PORT=3000
HOST=127.0.0.1
PAYOUT_BATCH_SIZE=25
# Root publisher may be a multisig; automatic publication explicitly trusts this key.
PUBLISHER_PRIVATE_KEY=
AUTO_PUBLISH=false
OWNER_PRIVATE_KEY=
ADMIN_BROADCAST=false
# Optional legacy-test-engine retirement recipient (defaults to owner).
RECOVERY_RECIPIENT=
# Fork integration: archive-capable RPC and the unused, bound test engine.
# No real private keys are used by npm run test:fork.
FORK_RPC_URL=
FORK_ENGINE_ADDRESS=
FORK_BLOCK_NUMBER=
FORK_PROCESS_ETH=0.001
